<Window x:Class="LePork.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LePork"
        Width="1180"
        Height="720"
        MinWidth="1000"
        MinHeight="620"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#071321"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>

        <Style x:Key="MainButton"
               TargetType="{x:Type Button}">
            <Setter Property="Background"
                    Value="#10253A"/>
            <Setter Property="Foreground"
                    Value="#B9E8FF"/>
            <Setter Property="BorderBrush"
                    Value="#214866"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="Padding"
                    Value="14,9"/>
            <Setter Property="Margin"
                    Value="0,5"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

        <Style x:Key="SidebarButton"
               TargetType="{x:Type Button}">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="#A9DDF5"/>
            <Setter Property="BorderBrush"
                    Value="#183047"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="Padding"
                    Value="14,10"/>
            <Setter Property="Margin"
                    Value="0,3"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid Background="#071321">

        <!-- OCEAN BACKGROUND -->
        <Canvas IsHitTestVisible="False">

            <Ellipse Width="900"
                     Height="380"
                     Canvas.Left="330"
                     Canvas.Top="170"
                     Fill="#0D3550"
                     Opacity="0.22"/>

            <Ellipse Width="650"
                     Height="280"
                     Canvas.Left="520"
                     Canvas.Top="260"
                     Fill="#12618A"
                     Opacity="0.10"/>

            <Path Fill="#0D3550"
                  Opacity="0.72"
                  Data="M0,570
                        C130,500 245,520 365,570
                        C500,625 615,470 760,525
                        C895,577 1035,475 1180,530
                        L1180,720
                        L0,720 Z"/>

            <Path Fill="#0E4B6B"
                  Opacity="0.82"
                  Data="M0,620
                        C145,540 250,610 390,625
                        C535,640 635,525 785,570
                        C920,610 1045,530 1180,590
                        L1180,720
                        L0,720 Z"/>

            <Path Fill="#12688F"
                  Opacity="0.90"
                  Data="M0,665
                        C125,605 260,635 400,675
                        C545,718 650,605 800,630
                        C945,652 1060,602 1180,635
                        L1180,720
                        L0,720 Z"/>

            <Path Fill="#5CC8F1"
                  Opacity="0.18"
                  Data="M0,675
                        C135,625 265,657 405,684
                        C545,710 665,620 805,640
                        C945,660 1070,620 1180,645
                        L1180,690
                        C1060,665 950,700 805,677
                        C660,654 550,740 400,704
                        C260,670 135,648 0,700 Z"/>

        </Canvas>

        <!-- LOGIN -->
        <Grid x:Name="LoginView"
              Background="#071321">

            <Border Width="410"
                    Padding="32"
                    Background="#091C2B"
                    BorderBrush="#1D4864"
                    BorderThickness="1"
                    CornerRadius="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="LePork"
                               Foreground="#BCEBFF"
                               FontSize="34"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="OPTIMIZATION PANEL"
                               Foreground="#5D9DBA"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,24"/>

                    <TextBlock Text="Access Code"
                               Foreground="#96CFE6"
                               FontSize="12"
                               Margin="0,0,0,7"/>

                    <PasswordBox x:Name="AccessCodeBox"
                                 Height="44"
                                 Padding="10"
                                 Background="#071521"
                                 Foreground="#D5F4FF"
                                 BorderBrush="#21516D"
                                 BorderThickness="1"
                                 FontSize="16"/>

                    <Button Content="ENTER LEPORK"
                            Height="48"
                            Margin="0,16,0,0"
                            Background="#0F6F98"
                            Foreground="#E6FAFF"
                            BorderBrush="#218CB7"
                            FontWeight="Bold"
                            Click="Login_Click"/>

                    <TextBlock x:Name="LoginStatus"
                               Foreground="#FF8585"
                               TextAlignment="Center"
                               Margin="0,12,0,0"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- MAIN APP -->
        <Grid x:Name="MainView"
              Visibility="Collapsed">

            <Grid.RowDefinitions>

                <RowDefinition x:Name="TopBarRow"
                               Height="62"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="36"/>

            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border x:Name="TopBar"
                    Grid.Row="0"
                    Background="#081725"
                    BorderBrush="#163149"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">

                <Grid Margin="20,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="LePork"
                                   Foreground="#BCEBFF"
                                   FontSize="23"
                                   FontWeight="Bold"/>

                        <Border Background="#0D3047"
                                BorderBrush="#1E5A7D"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,4"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">

                            <TextBlock Text="OPTIMIZATION PANEL"
                                       Foreground="#8DD8F7"
                                       FontSize="9"
                                       FontWeight="SemiBold"/>

                        </Border>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Button Content="—"
                                Width="40"
                                Height="32"
                                Background="Transparent"
                                Foreground="#8ACCE7"
                                BorderThickness="0"
                                FontSize="18"
                                Click="Minimize_Click"/>

                        <Button Content="□"
                                Width="40"
                                Height="32"
                                Background="Transparent"
                                Foreground="#8ACCE7"
                                BorderThickness="0"
                                FontSize="15"
                                Click="Maximize_Click"/>

                        <Button Content="×"
                                Width="40"
                                Height="32"
                                Background="Transparent"
                                Foreground="#8ACCE7"
                                BorderThickness="0"
                                FontSize="20"
                                Click="Close_Click"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- BODY -->
            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="215"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0"
                        Background="#081521"
                        BorderBrush="#173149"
                        BorderThickness="0,0,1,0">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="*"/>
                            <RowDefinition Height="48"/>

                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto">

                            <StackPanel Margin="10,18">

                                <TextBlock Text="MENU"
                                           Foreground="#547B91"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Margin="10,0,0,8"/>

                                <Button Content="Home"
                                        Style="{StaticResource SidebarButton}"
                                        Click="Home_Click"/>

                                <Button Content="Performance"
                                        Style="{StaticResource SidebarButton}"
                                        Click="Performance_Click"/>

                                <Button Content="KBM"
                                        Style="{StaticResource SidebarButton}"
                                        Click="KBM_Click"/>

                                <Button Content="Controller"
                                        Style="{StaticResource SidebarButton}"
                                        Click="Controller_Click"/>

                                <Button Content="Polling Rate"
                                        Style="{StaticResource SidebarButton}"
                                        Click="Polling_Click"/>

                                <Button Content="Network"
                                        Style="{StaticResource SidebarButton}"
                                        Click="Network_Click"/>

                                <Button Content="Windows"
                                        Style="{StaticResource SidebarButton}"
                                        Click="Windows_Click"/>

                                <Button Content="Fortnite"
                                        Style="{StaticResource SidebarButton}"
                                        Click="Fortnite_Click"/>

                                <Button Content="Advanced"
                                        Style="{StaticResource SidebarButton}"
                                        Click="Advanced_Click"/>

                            </StackPanel>

                        </ScrollViewer>

                        <Border Grid.Row="1"
                                Margin="10,5"
                                Background="#0D2A3D"
                                BorderBrush="#1B4965"
                                BorderThickness="1"
                                CornerRadius="9">

                            <TextBlock Text="LEPORK"
                                       Foreground="#8EDCF9"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>

                <!-- CONTENT -->
                <Grid Grid.Column="1"
                      Background="#071522">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <Grid Margin="28">

                            <!-- HOME -->
                            <StackPanel x:Name="HomePanel">

                                <TextBlock Text="Welcome to LePork"
                                           Foreground="#C3EEFF"
                                           FontSize="30"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Simple, clean, one-click optimization."
                                           Foreground="#6F9CB2"
                                           FontSize="13"
                                           Margin="0,6,0,20"/>

                                <Border Background="#0A1D2D"
                                        BorderBrush="#193F59"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="24">

                                    <StackPanel>

                                        <TextBlock Text="One-click optimization"
                                                   Foreground="#C3EEFF"
                                                   FontSize="21"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="Apply every supported LePork optimization from one button."
                                                   Foreground="#7295A8"
                                                   Margin="0,5,0,18"/>

                                        <Button Content="APPLY ALL OPTIMIZATIONS"
                                                Height="50"
                                                Background="#0F6F98"
                                                Foreground="#E6FAFF"
                                                BorderBrush="#218CB7"
                                                FontWeight="Bold"
                                                Click="ApplyAll_Click"/>

                                        <Button Content="RESTORE LEPORK CHANGES"
                                                Height="42"
                                                Margin="0,10,0,0"
                                                Style="{StaticResource MainButton}"
                                                Click="RestoreAll_Click"/>

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                            <!-- PERFORMANCE -->
                            <StackPanel x:Name="PerformancePanel"
                                        Visibility="Collapsed">

                                <TextBlock Text="Performance"
                                           Foreground="#C3EEFF"
                                           FontSize="28"
                                           FontWeight="Bold"/>

                                <TextBlock Text="System performance optimization"
                                           Foreground="#6F9CB2"
                                           Margin="0,5,0,20"/>

                                <Button Content="APPLY PERFORMANCE OPTIMIZATION"
                                        Height="48"
                                        Background="#0F6F98"
                                        Foreground="#E6FAFF"
                                        BorderBrush="#218CB7"
                                        FontWeight="Bold"
                                        Click="PerformanceApply_Click"/>

                                <Button Content="APPLY GAME MODE"
                                        Style="{StaticResource MainButton}"
                                        Click="GameModeApply_Click"/>

                                <Button Content="APPLY VISUAL OPTIMIZATION"
                                        Style="{StaticResource MainButton}"
                                        Click="VisualApply_Click"/>

                                <Button Content="APPLY STARTUP OPTIMIZATION"
                                        Style="{StaticResource MainButton}"
                                        Click="StartupApply_Click"/>

                            </StackPanel>

                            <!-- KBM -->
                            <StackPanel x:Name="KBMPanel"
                                        Visibility="Collapsed">

                                <TextBlock Text="Keyboard and Mouse"
                                           Foreground="#C3EEFF"
                                           FontSize="28"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Input optimization"
                                           Foreground="#6F9CB2"
                                           Margin="0,5,0,20"/>

                                <Button Content="APPLY MAX KBM OPTIMIZATION"
                                        Height="48"
                                        Background="#0F6F98"
                                        Foreground="#E6FAFF"
                                        BorderBrush="#218CB7"
                                        FontWeight="Bold"
                                        Click="KBMApply_Click"/>

                                <Button Content="DISABLE MOUSE ACCELERATION"
                                        Style="{StaticResource MainButton}"
                                        Click="MouseAccel_Click"/>

                                <Button Content="APPLY MAX POLLING RATE"
                                        Style="{StaticResource MainButton}"
                                        Click="PollingApply_Click"/>

                                <TextBlock x:Name="KbmStatus"
                                           Foreground="#6F9CB2"
                                           Margin="0,16,0,0"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                            <!-- CONTROLLER -->
                            <StackPanel x:Name="ControllerPanel"
                                        Visibility="Collapsed">

                                <TextBlock Text="Controller"
                                           Foreground="#C3EEFF"
                                           FontSize="28"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Controller optimization"
                                           Foreground="#6F9CB2"
                                           Margin="0,5,0,20"/>

                                <Button Content="APPLY MAX CONTROLLER OPTIMIZATION"
                                        Height="48"
                                        Background="#0F6F98"
                                        Foreground="#E6FAFF"
                                        BorderBrush="#218CB7"
                                        FontWeight="Bold"
                                        Click="ControllerApply_Click"/>

                                <Button Content="APPLY MAX POLLING RATE"
                                        Style="{StaticResource MainButton}"
                                        Click="PollingApply_Click"/>

                                <TextBlock x:Name="ControllerStatus"
                                           Foreground="#6F9CB2"
                                           Margin="0,16,0,0"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                            <!-- POLLING -->
                            <StackPanel x:Name="PollingPanel"
                                        Visibility="Collapsed">

                                <TextBlock Text="Polling Rate"
                                           Foreground="#C3EEFF"
                                           FontSize="28"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Highest polling rate supported by the device and driver."
                                           Foreground="#6F9CB2"
                                           Margin="0,5,0,20"
                                           TextWrapping="Wrap"/>

                                <Button Content="MAX POLLING RATE"
                                        Height="55"
                                        Background="#0F6F98"
                                        Foreground="#E6FAFF"
                                        BorderBrush="#218CB7"
                                        FontWeight="Bold"
                                        Click="PollingApply_Click"/>

                                <Border Background="#0A1D2D"
                                        BorderBrush="#193F59"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="20"
                                        Margin="0,18,0,0">

                                    <StackPanel>

                                        <TextBlock Text="Polling Status"
                                                   Foreground="#BCEBFF"
                                                   FontSize="17"
                                                   FontWeight="Bold"/>

                                        <TextBlock x:Name="PollingResult"
                                                   Text="No scan performed yet."
                                                   Foreground="#6F9CB2"
                                                   Margin="0,10,0,0"
                                                   TextWrapping="Wrap"/>

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                            <!-- NETWORK -->
                            <StackPanel x:Name="NetworkPanel"
                                        Visibility="Collapsed">

                                <TextBlock Text="Network"
                                           Foreground="#C3EEFF"
                                           FontSize="28"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Network optimization"
                                           Foreground="#6F9CB2"
                                           Margin="0,5,0,20"/>

                                <Button Content="APPLY NETWORK OPTIMIZATION"
                                        Height="48"
                                        Background="#0F6F98"
                                        Foreground="#E6FAFF"
                                        BorderBrush="#218CB7"
                                        FontWeight="Bold"
                                        Click="NetworkApply_Click"/>

                                <Button Content="FLUSH DNS CACHE"
                                        Style="{StaticResource MainButton}"
                                        Click="DnsApply_Click"/>

                                <Button Content="DISABLE GLOBAL TCP AUTOTUNING"
                                        Style="{StaticResource MainButton}"
                                        Click="DisableAutotuning_Click"/>

                                <Button Content="SET GLOBAL TCP AUTOTUNING TO NORMAL"
                                        Style="{StaticResource MainButton}"
                                        Click="NormalAutotuning_Click"/>

                                <Border Background="#0A1D2D"
                                        BorderBrush="#193F59"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="20"
                                        Margin="0,18,0,0">

                                    <TextBlock x:Name="NetworkStatus"
                                               Text="Checking..."
                                               Foreground="#6F9CB2"
                                               TextWrapping="Wrap"/>

                                </Border>

                            </StackPanel>

                            <!-- WINDOWS -->
                            <StackPanel x:Name="WindowsPanel"
                                        Visibility="Collapsed">

                                <TextBlock Text="Windows"
                                           Foreground="#C3EEFF"
                                           FontSize="28"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Windows optimization and repair"
                                           Foreground="#6F9CB2"
                                           Margin="0,5,0,20"/>

                                <Button Content="APPLY WINDOWS OPTIMIZATION"
                                        Height="48"
                                        Background="#0F6F98"
                                        Foreground="#E6FAFF"
                                        BorderBrush="#218CB7"
                                        FontWeight="Bold"
                                        Click="WindowsApply_Click"/>

                                <Button Content="APPLY GAME MODE"
                                        Style="{StaticResource MainButton}"
                                        Click="GameModeApply_Click"/>

                                <Button Content="APPLY VISUAL OPTIMIZATION"
                                        Style="{StaticResource MainButton}"
                                        Click="VisualApply_Click"/>

                                <Border Background="#0A1D2D"
                                        BorderBrush="#193F59"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="20"
                                        Margin="0,18,0,0">

                                    <StackPanel>

                                        <TextBlock Text="SYSTEM REPAIR"
                                                   Foreground="#BCEBFF"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,10"/>

                                        <Button Content="RUN SFC /SCANNOW"
                                                Style="{StaticResource MainButton}"
                                                Click="SfcScan_Click"/>

                                        <Button Content="REPAIR WINDOWS IMAGE"
                                                Style="{StaticResource MainButton}"
                                                Click="RestoreHealth_Click"/>

                                        <TextBlock x:Name="WindowsRepairStatus"
                                                   Foreground="#6F9CB2"
                                                   Margin="0,12,0,0"
                                                   TextWrapping="Wrap"/>

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                            <!-- FORTNITE -->
                            <StackPanel x:Name="FortnitePanel"
                                        Visibility="Collapsed">

                                <TextBlock Text="Fortnite"
                                           Foreground="#C3EEFF"
                                           FontSize="28"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Fortnite configuration"
                                           Foreground="#6F9CB2"
                                           Margin="0,5,0,20"/>

                                <Button Content="APPLY FORTNITE OPTIMIZATION"
                                        Height="48"
                                        Background="#0F6F98"
                                        Foreground="#E6FAFF"
                                        BorderBrush="#218CB7"
                                        FontWeight="Bold"
                                        Click="FortniteApply_Click"/>

                                <Button Content="BACKUP FORTNITE CONFIG"
                                        Style="{StaticResource MainButton}"
                                        Click="FortniteBackup_Click"/>

                                <Button Content="RESTORE FORTNITE CONFIG"
                                        Style="{StaticResource MainButton}"
                                        Click="FortniteRestore_Click"/>

                                <TextBlock x:Name="FortniteStatus"
                                           Foreground="#6F9CB2"
                                           Margin="0,16,0,0"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                            <!-- ADVANCED -->
                            <StackPanel x:Name="AdvancedPanel"
                                        Visibility="Collapsed">

                                <TextBlock Text="Advanced"
                                           Foreground="#C3EEFF"
                                           FontSize="28"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Advanced tools"
                                           Foreground="#6F9CB2"
                                           Margin="0,5,0,20"/>

                                <Button Content="APPLY ALL SAFE TWEAKS"
                                        Height="48"
                                        Background="#0F6F98"
                                        Foreground="#E6FAFF"
                                        BorderBrush="#218CB7"
                                        FontWeight="Bold"
                                        Click="ApplyAll_Click"/>

                                <Button Content="RESTORE LEPORK CHANGES"
                                        Style="{StaticResource MainButton}"
                                        Click="RestoreAll_Click"/>

                                <Button Content="TASK MANAGER"
                                        Style="{StaticResource MainButton}"
                                        Click="TaskManager_Click"/>

                                <Button Content="DEVICE MANAGER"
                                        Style="{StaticResource MainButton}"
                                        Click="DeviceManager_Click"/>

                                <Button Content="COMMAND PROMPT"
                                        Style="{StaticResource MainButton}"
                                        Click="Cmd_Click"/>

                            </StackPanel>

                        </Grid>

                    </ScrollViewer>

                </Grid>

            </Grid>

            <!-- STATUS BAR -->
            <Border Grid.Row="2"
                    Background="#081725"
                    BorderBrush="#163149"
                    BorderThickness="0,1,0,0">

                <TextBlock x:Name="StatusText"
                           Text="LePork ready."
                           Foreground="#72B7D5"
                           VerticalAlignment="Center"
                           Margin="20,0"/>

            </Border>

        </Grid>

    </Grid>

</Window>